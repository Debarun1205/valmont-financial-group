# Leave blank to use the Vite proxy to the local Express API on :4000.
# For Vercel production, set to your Render API origin, e.g. https://valmont-finance-api.onrender.com
VITE_API_URL=
# Same OAuth Web client ID as GOOGLE_CLIENT_ID on Render (optional if the API /api/auth/config returns it).
# https://console.cloud.google.com/apis/credentials
VITE_GOOGLE_CLIENT_ID=
# Only set true for a credential-free local demo. Leave unset/false on Vercel if VITE_API_URL is set —
# otherwise Google sign-in is skipped.
VITE_DEMO_MODE=false
