# Copy to .env and fill in as you get each sponsor credential during the hackathon.
# Every integration below has a mock fallback — the app runs with ZERO keys filled in.
# Flip USE_MOCKS=false (or leave individual keys blank) once you have real credentials.

PORT=4000

# --- Database (Tiger Data / TimescaleDB) ---
DATABASE_URL=postgres://postgres:devpassword@localhost:5432/financeapp

# --- Auth0 ---
# Leave DEV_AUTH_BYPASS=true to skip real Auth0 during early development.
DEV_AUTH_BYPASS=true
AUTH0_DOMAIN=
AUTH0_AUDIENCE=

# --- Gemini API (primary) ---
# If blank, text AI tries Groq next; OCR falls back to mock.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash

# --- Groq free-tier fallback (text JSON features) ---
# Get a key at https://console.groq.com — used when Gemini is missing/fails.
GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# --- Deploy helpers ---
# Comma-separated frontend origins for CORS (Vercel URL).
CORS_ORIGIN=
# Set true for Neon / Render managed Postgres TLS.
DATABASE_SSL=false

# --- Solana ---
# If blank, trust-score "attestation" is logged but not actually sent to devnet.
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_SECRET_KEY=

# --- ElevenLabs (wired at the Tier 1 checkpoint) ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# --- Crypto price feed (Module 11, Checkpoint 7) ---
# If blank, SOL/USD price defaults to a static mock ($150).
# Expects a CoinGecko-shaped endpoint, e.g.:
# https://api.coingecko.com/api/v3/simple/price?ids=solana&vs_currencies=usd
CRYPTO_PRICE_API_URL=

# --- FX rate feed (Module 12, Checkpoint 8) ---
# If blank, uses a static mock rate table (INR/PHP/MXN/NGN/KES).
# Expects an exchangerate.host-shaped endpoint, e.g.:
# https://api.exchangerate.host/latest?base=USD
FX_API_URL=

# --- Gold price feed (Module 11 extension, Checkpoint 10) ---
# If blank, gold price defaults to a static mock ($75/gram).
# Expects a GoldAPI-shaped endpoint, e.g.: https://www.goldapi.io/api/XAU/USD
GOLD_PRICE_API_URL=
